# Server
PORT=5000
NODE_ENV=development

# Database (MySQL - local install)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=scfmp_db
DB_USER=root
DB_PASSWORD=your_mysql_password
# Production alternative: a single managed-MySQL connection URL.
# DATABASE_URL=mysql://user:password@host:3306/scfmp_db
# TiDB's Vercel integration can provide TIDB_HOST, TIDB_PORT, TIDB_USER,
# TIDB_PASSWORD, and TIDB_DATABASE instead of the DB_* variables above.
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_too_to_another_long_random_string
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=scfmp-api
JWT_AUDIENCE=scfmp-web
LOGIN_RATE_LIMIT_MAX=10

# Fresh database provisioning (used only by the administrator seeder)
INITIAL_ADMIN_EMAIL=admin@smartnyamagabe.rw
INITIAL_ADMIN_PASSWORD=replace_with_a_unique_temporary_password

# CORS
CLIENT_URL=http://localhost:5173

# Email (for password reset links) — leave SMTP_HOST blank to disable real email
# sending during local dev; reset links will be logged to the server console instead.
#
# For Gmail: SMTP_USER is the full address, SMTP_PASS is a 16-character "App
# Password" (Google Account -> Security -> 2-Step Verification -> App Passwords),
# NOT your normal Gmail password — Gmail will reject the normal password over SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_16_character_gmail_app_password
SMTP_FROM=SCFMP <no-reply@example.com>

# How long a password reset link stays valid, in minutes
RESET_TOKEN_EXPIRES_MINUTES=30

# Persistent document storage. Connect a Vercel Blob store in the Vercel dashboard;
# Vercel injects BLOB_READ_WRITE_TOKEN (or BLOB_STORE_ID with OIDC) automatically.
DOCUMENT_STORAGE=local
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
